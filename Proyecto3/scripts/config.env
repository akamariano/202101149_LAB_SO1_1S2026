# Variables compartidas por todos los scripts del Proyecto 3.
# Uso: source "$(dirname "$0")/config.env"

export CARNET="202101149"
export PROJECT_ID="so1-p3-202101149"
export REGION="us-central1"
export ZONE="us-central1-c"   # us-central1-a sin capacidad N1 (06/10/2026)

# --- Zot (VM fuera del clúster) ---
export ZOT_VM="zot-vm"
export ZOT_IP_NAME="zot-ip"
export ZOT_MACHINE="n1-standard-1"
export ZOT_VERSION="v2.1.22"
export ZOT_USER="admin"
# Zonas candidatas para la VM (misma región que la IP estática). Si una zona no tiene
# capacidad (ZONE_RESOURCE_POOL_EXHAUSTED), 01_zot_vm.sh prueba la siguiente.
export ZOT_ZONES="us-central1-b us-central1-c us-central1-f us-central1-a"
# Zona donde quedó creada la VM (vacío si aún no existe)
zot_zone() { gcloud compute instances list --filter="name=$ZOT_VM" --format='value(zone.basename())' 2>/dev/null; }
# ZOT_DOMAIN se calcula a partir de la IP estática (ver 01_zot_vm.sh) y se guarda en .secrets/zot.env

# --- GKE ---
export CLUSTER="so1-p3"
export NODE_MACHINE="n1-standard-2"
export NODE_COUNT="3"

export PATH="/opt/homebrew/share/google-cloud-sdk/bin:$PATH"

# Raíz del proyecto y carpeta de secretos (ignorada por git)
export P3_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export SECRETS_DIR="$P3_ROOT/.secrets"
